{
  "appId": "ua.rivna.app",
  "appName": "Rivna",
  "webDir": "www",
  "server": {
    "url": "https://rivna-app.xyz",
    "cleartext": false,
    "errorPath": "offline.html",
    "allowNavigation": [
      "rivna-app.xyz",
      "*.supabase.co",
      "*.vercel.app"
    ]
  },
  "ios": {
    "scheme": "Rivna",
    "contentInset": "never",
    "backgroundColor": "#0e0d0b",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 3000,
      "backgroundColor": "#0e0d0b",
      "showSpinner": false,
      "iosSpinnerStyle": "small"
    },
    "StatusBar": {
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
